# Copy to .env and adjust as needed.
DATABASE_URL=postgresql+asyncpg://taskmanager@localhost:5433/taskmanager_dev
TEST_DATABASE_URL=postgresql+asyncpg://taskmanager@localhost:5433/taskmanager_test

# Header used to stub the authenticated user's identity (see README for rationale).
AUTH_HEADER_NAME=X-User-Id

# Server-side cap on GraphQL connection page size (the `first` argument).
MAX_PAGE_SIZE=100
